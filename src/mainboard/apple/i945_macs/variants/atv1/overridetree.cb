## SPDX-License-Identifier: GPL-2.0-only

chip northbridge/intel/i945
	device domain 0 on
		device pci 01.0 on end	# PCIe root port, GeForce Go 7300 behind it
		device pci 02.0 off end	# IGD is unused on this board
		device pci 02.1 off end	# display controller

		chip southbridge/intel/i82801gx
			# The board routes no PIRQ to a legacy IRQ; the ACPI
			# MADT maps PIRQA..PIRQG to GSIs 16..22.
			register "pirqa_routing" = "0x80"
			register "pirqb_routing" = "0x80"
			register "pirqc_routing" = "0x80"
			register "pirqd_routing" = "0x80"
			register "pirqe_routing" = "0x80"
			register "pirqf_routing" = "0x80"
			register "pirqg_routing" = "0x80"
			register "pirqh_routing" = "0x80"

			# Do not route any GPI: the GPIO block is the
			# handshake to the board's power/thermal MCU.
			register "gpi1_routing" = "0"
			register "gpi7_routing" = "0"
			register "gpe0_en" = "0"
			register "alt_gp_smi_en" = "0"

			# No SATA and no Mac-specific LPC decode windows.
			register "sata_ports_implemented" = "0"
			register "gen1_dec" = "0"
			register "gen2_dec" = "0"
			register "gen3_dec" = "0"
			register "gen4_dec" = "0"

			# The vendor FADT has duty_width = 3 and the measured
			# GEN_PMCON_1 has the C4-on-C3 bit clear.
			register "p_cnt_throttling_supported" = "true"
			register "c4onc3_enable" = "false"
			register "c3_latency" = "0x10"

			# One PATA channel only.
			register "ide_enable_primary" = "true"
			register "ide_enable_secondary" = "false"

			device pci 1b.0 on	# HDA, Realtek ALC885
				subsystemid 0x10ec 0x0885
			end

			device pci 1c.0 off end
			device pci 1c.1 off end
			device pci 1d.1 off end
			device pci 1d.2 off end
			device pci 1d.3 off end
			device pci 1f.2 off end	# no SATA/AHCI
		end
	end
end
